                  "event_name": "ambient.in.air"
                }
              ]
            }
          ]
        }
      },
      {
        "id": "range",
        "title": "Range",
        "description": "Maximum time in seconds to randomly add to the ambient sound delay time.",
        "defaultValue": 16,
        "dataType": "float"
