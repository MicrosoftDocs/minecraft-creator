                  {
                    "path": "liquid_type",
                    "content": "water"
                  }
                ]
              }
            },
            {
              "id": "can_contain_liquid",
              "title": "Can contain liquid",
              "dataType": "string",
              "samples": {
                "/vanilla/behavior_pack/blocks/black_concrete_slab.block.json": [
                  {
                    "path": "can_contain_liquid",
                    "content": true
                  }
                ]
              }
            },
            {
              "id": "on_liquid_touches",
              "title": "On liquid touches",
              "dataType": "string",
              "samples": {
                "/vanilla/behavior_pack/blocks/black_concrete_slab.block.json": [
                  {
                    "path": "on_liquid_touches",
                    "content": "blocking"
                  }
