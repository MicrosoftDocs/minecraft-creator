  "generated_doNotEdit": {
    "id": "minecraft:liquid_detection",
    "title": "Liquid Detection",
    "description": "The definitions for how a block behaves when detecting liquid. Only one rule definition is allowed per liquid type - if multiple are specified, the first will be used and the rest will be ignored.\nExperimental toggles required: Upcoming Creator Features (in format versions before 1.21.60)",
    "fields": [
      {
        "id": "can_contain_liquid",
        "title": "Can Contain Liquid",
        "description": "Whether this block can contain the liquid. For example, if the liquid type is `water`, this means the block can be waterlogged.",
        "defaultValue": false,
        "dataType": "boolean"
      },
      {
        "id": "liquid_type",
        "title": "Liquid Type",
        "description": "The type of liquid this detection rule is for. Currently, `water` is the only supported liquid type. If this field is omitted, `water` will be the liquid type by default.",
        "defaultValue": "water",
        "dataType": "string"
      },
      {
        "id": "on_liquid_touches",
        "title": "Liquid Touches",
        "description": "How the block reacts to flowing water. Must be one of the following options:\n\"blocking\" - The default value for this field. The block stops the liquid from flowing.\n\"broken\" - The block is destroyed completely.\n\"popped\" - The block is destroyed and its item is spawned.\n\"no_reaction\" - The block is unaffected; visually, the liquid will flow through the block.",
        "defaultValue": "blocking",
        "dataType": "minecraftEventTrigger"
      },
      {
        "id": "stops_liquid_flowing_from_direction",
        "title": "Stops Liquid Flowing From Direction",
        "description": "When a block contains a liquid, controls the directions in which the liquid can't flow out from the block. Also controls the directions in which a block can stop liquid flowing into it if `no_reaction` is set for the `on_liquid_touches` field. Can be a list of the following directions: \"up\", \"down\", \"north\", \"south\", \"east\", \"west\". The default is an empty list; this means that liquid can flow out of all directions by default.",
        "dataType": "stringArray"
      },
      {
        "id": "use_liquid_clipping",
        "title": "Use Liquid Clipping",
        "description": "Whether this block uses the encompassing collider to visually clip the liquid. The encompassing collider is the smallest single AABB that contains all of the block's colliders.\nA liquid's base visual shape is ALWAYS a quad, they do not have more subdivisions.\nWhen use_liquid_clipping is TRUE, the game will attempt to reduce the visible volume of water if the collision shape allows it. Eg. a wall will turn the water base shape into a rectangle on the side of the incoming water.\nWhen use_liquid_clipping is FALSE, the game will preserve the water base shape as a full square, no matter what the collision shape of the block they share space with is.",
        "defaultValue": false,
        "dataType": "boolean"
      },
      {
        "id": "detection_rules",
        "title": "Detection Rules",
        "dataType": "objectArray",
        "subForm": {
          "id": "detection_rules",
          "title": "Detection rules",
          "fields": [
            {
              "id": "liquid_type",
              "title": "Liquid type",
              "dataType": "string",
              "samples": {
